# Environment variables
.env

# Byte-compiled / optimized / DLL files
__pycache__/

# PyCharm / JetBrains IDE files
.idea/

# Log files
app.log
app.log.*

# macOS system files
.DS_Store

# Build artifacts and distribution directories
build/
dist/

# Webpack bundles and source maps
*.bundle.js
*.bundle.js.map
*.map

# Coverage reports
.coverage
htmlcov/

# pytest cache
.pytest_cache/
*.egg-info

# Virtual environments
venv/
.venv/

# Temporary files for testing and deployment
uploads/

# Node.js dependencies
node_modules/

# Features symlinks
features

# Per-machine lifecycle state, written by the CLI: it records when each
# feature was installed and migrated ON THIS MACHINE. Sharing it between
# machines is meaningless and makes every deployment pull conflict.
splent.manifest.json

splent.manifest.json

# Real environment files. product:deploy writes docker/.env.deploy with the
# database passwords the operator typed, and a plain ".env" rule does not
# match it, so it would sit untracked next to the tracked templates waiting
# for someone to run git add -A on a server. Only the hand-maintained
# *.example templates belong here.
.env
.env.*
!.env.example
!.env.dev.example
!.env.prod.example

# Deployment artifacts, regenerated by product:build on every machine that
# deploys. Versioning them makes each deployment pull conflict with whatever
# the last machine generated, the same problem as splent.manifest.json.
docker/.env.deploy.example
docker/docker-compose.deploy.yml
